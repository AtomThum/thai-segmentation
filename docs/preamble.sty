\NewTCBListing{texsource}{ m }{
  listing engine=minted,
  listing only,
  minted language=latex,
  minted options={
    fontsize=\small,
    breaklines=true,
    linenos=true,
  },
  colback=CodeCol,
  colframe=black,
  boxrule=0pt,
  toprule=1pt,
  bottomrule=1pt,
  sharp corners,
  fonttitle=\ttfamily,
  left=10mm,
  title={#1},
  breakable
}
\NewTCBListing{bashsource}{ m }{
  listing engine=minted,
  listing only,
  minted language=bash,
  minted options={
    fontsize=\small,
    breaklines=true,
    linenos=true,
  },
  colback=CodeCol,
  colframe=black,
  boxrule=0pt,
  toprule=1pt,
  bottomrule=1pt,
  sharp corners,
  fonttitle=\ttfamily,
  left=10mm,
  title={#1},
  breakable, enhanced
}
